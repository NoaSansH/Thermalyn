                            <TextBlock Text="{DynamicResource Monitor.NotificationHelp}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel x:Name="NotificationOptions" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Monitor.Delay}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="AlertDelayCombo" AutomationProperties.Name="{DynamicResource Monitor.Delay}"/>
                                <TextBlock Text="{DynamicResource Monitor.Cooldown}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <ComboBox x:Name="AlertCooldownCombo" AutomationProperties.Name="{DynamicResource Monitor.Cooldown}"/>
                            </StackPanel>
                        </StackPanel></Border>
                        <TextBlock Text="{DynamicResource Head.Behaviour}" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="StartupCheck" Content="{DynamicResource Settings.StartWithWindows}" Style="{StaticResource Toggle}"/><CheckBox x:Name="TopmostCheck" Content="{DynamicResource Settings.AlwaysOnTop}" Style="{StaticResource Toggle}"/><CheckBox x:Name="MinimizeToTrayCheck" Style="{StaticResource Toggle}"><TextBlock Text="{DynamicResource Monitor.MinimizeToTray}" TextWrapping="Wrap"/></CheckBox><TextBlock Text="{DynamicResource Monitor.TrayHelp}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,10"/><CheckBox x:Name="ProcessesCheck" Content="{DynamicResource Settings.TrackProcesses}" Style="{StaticResource Toggle}"/></StackPanel></Border>
                        <TextBlock Text="{DynamicResource Update.SettingsTitle}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Update.SettingsDescription}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SettingsUpdateStatusText" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <Button x:Name="SettingsCheckUpdateButton" Content="{DynamicResource Update.CheckNow}" Style="{StaticResource PillButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="SettingsCheckUpdate_Click"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PurgeSectionTitle" Text="{DynamicResource Head.Data}" Style="{StaticResource SectionTitle}"/>
                        <Border x:Name="PurgeSection" Style="{StaticResource Card}"><StackPanel>
                            <TextBlock Text="{DynamicResource Settings.PurgeBody}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock x:Name="PurgeWarning" Visibility="Collapsed" Text="{DynamicResource Settings.PurgeWarning}" Foreground="{DynamicResource TempCriticalBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button x:Name="PurgeButton" Content="{DynamicResource Settings.Purge}" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Click="PurgeData_Click"/>
                        </StackPanel></Border>
                        <TextBlock Text="{DynamicResource Settings.VendorNote}" TextWrapping="Wrap" Style="{StaticResource MetaText}" Margin="2,16,2,0"/>
                        <TextBlock x:Name="AppVersionText" Style="{StaticResource MetaText}" Margin="2,10,2,0"/>
                    </StackPanel></ScrollViewer>
                    <Button x:Name="SaveSettingsButton" Grid.Row="2" Content="{DynamicResource Settings.Save}" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/>
                </Grid>
            </Border>

            <Border x:Name="LoadingOverlay" Background="{DynamicResource CanvasBrush}" Panel.ZIndex="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <Grid Width="44" Height="44" HorizontalAlignment="Center"><Rectangle Fill="{DynamicResource AccentBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/LogoOuter.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle><Rectangle Fill="{DynamicResource AccentDeepBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/LogoInner.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle></Grid>
                    <TextBlock Text="Thermalyn" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="LoadingMessage" Text="{DynamicResource Status.ReadingSensors}" Style="{StaticResource MetaText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <Border Width="200" Height="3" Background="{DynamicResource BorderSubtleBrush}" CornerRadius="2" Margin="0,22,0,0" ClipToBounds="True" HorizontalAlignment="Center">
                        <Border Width="70" Height="3" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.RenderTransform><TranslateTransform x:Name="LoadingSlide"/></Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="ColorPickerOverlay" Visibility="Collapsed" Background="{DynamicResource ScrimBrush}" Panel.ZIndex="30" MouseLeftButtonUp="ColorPickerBackdrop_Click">
                <Border Style="{StaticResource Card}" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" MaxWidth="410" MaxHeight="650" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonUp="ColorPickerCard_Click">
                    <ScrollViewer><StackPanel><Grid Margin="0,0,0,14"><StackPanel><TextBlock x:Name="ColorPickerTitle" Text="{DynamicResource Picker.Title}" Style="{StaticResource PageTitle}" FontSize="18"/><TextBlock Text="{DynamicResource Picker.Subtitle}" Style="{StaticResource MetaText}" Margin="0,2,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Style="{StaticResource IconButton}" Click="CancelPickerColor_Click"><controls:Icon Data="{StaticResource IconX}" Width="14" Height="14" StrokeThickness="1.7" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button></Grid><controls:ColorWheel x:Name="PopupColorWheel" Width="220" Height="220" HorizontalAlignment="Center" ColorChanged="PopupColorWheel_ColorChanged"/><TextBlock Text="{DynamicResource Picker.Brightness}" Style="{StaticResource FieldLabel}" Margin="0,12,0,2"/><Slider x:Name="PopupBrightnessSlider" Minimum="8" Maximum="100" Value="100" ValueChanged="PopupBrightnessSlider_ValueChanged"/><TextBlock Text="{DynamicResource Picker.Presets}" Style="{StaticResource FieldLabel}" Margin="0,10,0,8"/><WrapPanel><Button Style="{StaticResource SwatchButton}" Margin="0,0,7,7" Background="#3B9EFF" Tag="#3B9EFF" Click="PopupSwatch_Click"/><Button Style="{StaticResource SwatchButton}" Margin="0,0,7,7" Background="#4D9E92" Tag="#4D9E92" Click="PopupSwatch_Click"/><Button Style="{StaticResource SwatchButton}" Margin="0,0,7,7" Background="#8A76C4" Tag="#8A76C4" Click="PopupSwatch_Click"/><Button Style="{StaticResource SwatchButton}" Margin="0,0,7,7" Background="#FFA83B" Tag="#FFA83B" Click="PopupSwatch_Click"/><Button Style="{StaticResource SwatchButton}" Margin="0,0,7,7" Background="#B06A87" Tag="#B06A87" Click="PopupSwatch_Click"/><Button Style="{StaticResource SwatchButton}" Margin="0,0,7,7" Background="#5E9E68" Tag="#5E9E68" Click="PopupSwatch_Click"/><Button Style="{StaticResource SwatchButton}" Margin="0,0,7,7" Background="#8A9099" Tag="#8A9099" Click="PopupSwatch_Click"/><Button Style="{StaticResource SwatchButton}" Margin="0,0,7,7" Background="#FF5C5C" Tag="#FF5C5C" Click="PopupSwatch_Click"/></WrapPanel><TextBlock Text="{DynamicResource Picker.Hex}" Style="{StaticResource FieldLabel}" Margin="0,6,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBox x:Name="PopupHexText" Text="#3B9EFF" TextChanged="PopupHexText_Changed"/><Border x:Name="PopupColorPreview" Grid.Column="1" Background="#3B9EFF" CornerRadius="6" Margin="8,0,0,0"/></Grid><TextBlock x:Name="ColorPickerWarning" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource TempHotBrush}" FontSize="11" Margin="0,10,0,0"/><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="{DynamicResource Picker.Cancel}" Style="{StaticResource PillButton}" Height="36" Margin="0,0,4,0" Click="CancelPickerColor_Click"/><Button Grid.Column="1" Content="{DynamicResource Picker.Apply}" Style="{StaticResource PrimaryButton}" Margin="4,0,0,0" Click="ApplyPickerColor_Click"/></Grid></StackPanel></ScrollViewer>
                </Border>
            </Border>
        </Grid>

        <Border x:Name="BottomNavigation" Grid.Row="4" Visibility="Collapsed" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="4">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="MiniNavIcon" Grid.Column="0" Style="{StaticResource IconButton}" Click="Mini_Click" ToolTip="{DynamicResource Nav.Mini}"><controls:Icon Data="{StaticResource IconActivity}" Width="18" Height="18" StrokeThickness="1.8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                <Button x:Name="CompactNavIcon" Grid.Column="1" Style="{StaticResource IconButton}" Click="Compact_Click" ToolTip="{DynamicResource Nav.Compact}"><controls:Icon Data="{StaticResource IconGauge}" Width="18" Height="18" StrokeThickness="1.8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                <Button x:Name="BalancedNavIcon" Grid.Column="2" Style="{StaticResource IconButton}" Click="Balanced_Click" ToolTip="{DynamicResource Nav.Balanced}"><controls:Icon Data="{StaticResource IconLayoutDashboard}" Width="18" Height="18" StrokeThickness="1.8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                <Button x:Name="DetailedNavIcon" Grid.Column="3" Style="{StaticResource IconButton}" Click="Detailed_Click" ToolTip="{DynamicResource Nav.Detailed}"><controls:Icon Data="{StaticResource IconChart}" Width="18" Height="18" StrokeThickness="1.8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="{DynamicResource Nav.Settings}"><controls:Icon Data="{StaticResource IconSettings}" Width="18" Height="18" StrokeThickness="1.8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
            </Grid>
        </Border>
    </Grid>
</Window>
