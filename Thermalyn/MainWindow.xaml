<Window x:Class="Thermalyn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Thermalyn.Controls"
        Title="Thermalyn" Width="1200" Height="820" MinWidth="320" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout" Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition x:Name="TopNavigationRow" Height="47"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomNavigationRow" Height="0"/>
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid Width="14" Height="14" VerticalAlignment="Center"><Rectangle Fill="{DynamicResource AccentBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/LogoOuter.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle><Rectangle Fill="{DynamicResource AccentDeepBrush}"><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/LogoInner.png" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle></Grid>
                    <TextBlock Text="Thermalyn" FontSize="11.5" Foreground="{DynamicResource IconBrush}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CopyDiagnosticButton" Style="{StaticResource CaptionButton}" Click="CopyDiagnostic_Click"
                            ToolTip="{DynamicResource Session.Copy}" AutomationProperties.Name="{DynamicResource Session.Copy}">
                        <controls:Icon Data="{StaticResource IconCopy}" Width="16" Height="16"
                                       Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                    </Button>
                    <Button x:Name="UpdateButton" Style="{StaticResource CaptionButton}" Click="UpdateButton_Click"
                            ToolTip="{DynamicResource Update.Checking}" AutomationProperties.Name="{DynamicResource Update.Title}">
                        <Grid Width="18" Height="18">
                            <controls:Icon Data="{StaticResource IconDownload}" Width="16" Height="16"
                                           Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"/>
                            <Ellipse x:Name="UpdateBadge" Visibility="Collapsed" Width="7" Height="7"
                                     Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource CanvasBrush}" StrokeThickness="1.5"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MinimizeCaptionButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow_Click"><Border Width="10" Height="1" Background="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button x:Name="MaximizeCaptionButton" Style="{StaticResource CaptionButton}" Click="MaximizeWindow_Click"><Grid Width="10" Height="10"><Border x:Name="MaximizeGlyph" BorderBrush="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1" CornerRadius="1"/><Path x:Name="RestoreGlyph" Visibility="Collapsed" Data="M3,1 H10 V8 M1,3 H8 V10 H1 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/></Grid></Button>
                    <Button x:Name="CloseCaptionButton" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow_Click"><controls:Icon Data="{StaticResource IconX}" Width="18" Height="18" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Popup x:Name="UpdatePopup" Grid.Row="0" PlacementTarget="{Binding ElementName=UpdateButton}"
               Placement="Bottom" HorizontalOffset="-316" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
               WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Width="360" MaxHeight="510" Margin="8" Padding="18" CornerRadius="7"
                    Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.28"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Update.Title}" Style="{StaticResource PageTitle}" FontSize="17"/>
                            <TextBlock x:Name="UpdateCheckingText" Text="{DynamicResource Update.Checking}" Style="{StaticResource MetaText}" Margin="0,4,0,0"/>
                            <TextBlock x:Name="UpdateUpToDateText" Visibility="Collapsed" Text="{DynamicResource Update.UpToDate}" Style="{StaticResource MetaText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Style="{StaticResource IconButton}"
                                Click="UpdateButton_Click" AutomationProperties.Name="{DynamicResource Common.Close}">
                            <controls:Icon Data="{StaticResource IconX}" Width="14" Height="14" StrokeThickness="1.7"
                                           Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="UpdateAvailablePanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{DynamicResource Update.Installed}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="UpdateCurrentVersionText" Style="{StaticResource MonoValue}"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Update.Available}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="UpdateLatestVersionText" Style="{StaticResource MonoValue}" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Update.Changes}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="11" MaxHeight="220">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="UpdateReleaseNotesText" Style="{StaticResource MetaText}" TextWrapping="Wrap"/></ScrollViewer>
                        </Border>
                        <TextBlock Text="{DynamicResource Update.Security}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <ProgressBar x:Name="UpdateProgressBar" Maximum="100" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="UpdateProgressText" Style="{StaticResource MetaText}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateErrorText" Visibility="Collapsed" Foreground="{DynamicResource TempCriticalBrush}" TextWrapping="Wrap" FontSize="11.5" Margin="0,12,0,0"/>

                    <Button x:Name="UpdateDownloadButton" Visibility="Collapsed" Content="{DynamicResource Update.Download}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="DownloadUpdate_Click"/>
                    <Button x:Name="UpdateRestartButton" Visibility="Collapsed" Content="{DynamicResource Update.RestartInstall}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="RestartAndInstallUpdate_Click"/>
                    <Button x:Name="UpdateRetryButton" Visibility="Collapsed" Content="{DynamicResource Update.Retry}" Style="{StaticResource PillButton}" Margin="0,12,0,0" Click="RetryUpdate_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <Border x:Name="NavigationBar" Grid.Row="1" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="32,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MiniButton" Content="{DynamicResource Nav.Mini}" Style="{StaticResource NavButton}" Click="Mini_Click"/>
                    <Button x:Name="CompactButton" Content="{DynamicResource Nav.Compact}" Style="{StaticResource NavButton}" Click="Compact_Click"/>
                    <Button x:Name="BalancedButton" Content="{DynamicResource Nav.Balanced}" Style="{StaticResource NavButton}" Click="Balanced_Click"/>
                    <Button x:Name="DetailedButton" Content="{DynamicResource Nav.Detailed}" Style="{StaticResource NavButton}" Click="Detailed_Click"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="{DynamicResource Nav.Settings}">
                    <controls:Icon Data="{StaticResource IconSettings}" Width="15" Height="15" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="HardwareDriverBanner" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="32,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Data="{StaticResource IconCpu}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HardwareDriverTitle" Text="{DynamicResource Driver.TitleGeneric}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="9,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="HardwareDriverMessage" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="23,3,0,0"/>
                    <TextBlock x:Name="HardwareDriverHint" Text="{DynamicResource Driver.Hint}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="23,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Driver.Later}" Style="{StaticResource PillButton}" Height="36" Margin="0,0,8,0" Click="DismissHardwareDriver_Click"/>
                    <Button x:Name="InstallHardwareDriverButton" Content="{DynamicResource Driver.Install}" Style="{StaticResource PrimaryButton}" Click="InstallHardwareDriver_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" x:Name="ContentHost">
            <ScrollViewer x:Name="BalancedView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="32,28">
                <Grid x:Name="BalancedAdaptiveGrid" HorizontalAlignment="Stretch" MaxWidth="1680">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="BalancedPrimaryColumn" Width="*"/><ColumnDefinition x:Name="BalancedSecondaryColumn" Width="0"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="BalancedSecondaryRow" Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="BalancedPrimary">
                        <TextBlock x:Name="StatusText" Text="{DynamicResource Status.Initialising}" Style="{StaticResource MetaText}" Margin="2,0,0,14"/>
                        <UniformGrid x:Name="HeroGrid" Columns="2" Margin="-8,0">
                            <controls:ComponentCard x:Name="CpuHeroCard" Heading="{DynamicResource Head.Processor}" IconData="{StaticResource IconCpu}" Margin="8,0" MouseLeftButtonUp="CpuCard_Click"/>
                            <controls:ComponentCard x:Name="GpuHeroCard" Heading="{Binding GpuHeading}" IconData="{StaticResource IconGpu}" Margin="8,0" MouseLeftButtonUp="GpuCard_Click"/>
                        </UniformGrid>

                        <TextBlock x:Name="ActiveGpuNote" Text="{DynamicResource Status.ActiveGpuNote}" Style="{StaticResource MetaText}" Margin="2,10,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="{DynamicResource Head.Measures}" Style="{StaticResource SectionTitle}"/>
                        <Border x:Name="SecondaryMetricsCard" Style="{StaticResource Card}" Padding="18,15">
                            <UniformGrid x:Name="SecondaryMetrics" Columns="4">
                                <StackPanel x:Name="CpuClockMetric" Margin="0,0,16,0"><TextBlock Text="{DynamicResource Metric.CpuFrequency}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CpuClock" Text="—" FontSize="15" Style="{StaticResource MonoValue}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <StackPanel x:Name="CpuPowerMetric" Margin="0,0,16,0"><TextBlock Text="{DynamicResource Metric.CpuPower}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="CpuPower" Text="—" FontSize="15" Style="{StaticResource MonoValue}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <StackPanel x:Name="GpuPowerMetric" Margin="0,0,16,0"><TextBlock Text="{DynamicResource Metric.GpuPower}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="GpuPower" Text="—" FontSize="15" Style="{StaticResource MonoValue}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <StackPanel x:Name="RamLoadMetric"><TextBlock Text="{DynamicResource Common.Ram}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="BalancedRamMetric" Text="—" FontSize="15" Style="{StaticResource MonoValue}" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="BalancedSecondary" Grid.Row="1">
                        <TextBlock x:Name="SystemSectionTitle" Text="{DynamicResource Head.System}" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource ListCard}">
                            <StackPanel x:Name="BalancedSystemList">
                                <StackPanel x:Name="BalancedGpuPanel"/>
                                <Border x:Name="RamSystemRow" Tag="Row" Style="{StaticResource Row}" Cursor="Hand" MouseLeftButtonUp="RamCard_Click">
                                    <Grid x:Name="RamSystemGrid"><Grid.ColumnDefinitions><ColumnDefinition x:Name="RamLabelColumn" Width="260"/><ColumnDefinition/><ColumnDefinition x:Name="RamValueColumn" Width="78"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="RamNarrowRow" Height="0"/></Grid.RowDefinitions>
                                        <StackPanel x:Name="RamSystemLabel" Orientation="Horizontal"><controls:Icon Data="{StaticResource IconMemory}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/><TextBlock Text="{DynamicResource Common.Ram}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/><TextBlock x:Name="RamValue" Text="—" Style="{StaticResource MetaText}" Margin="7,1,0,0" VerticalAlignment="Center"/></StackPanel>
                                        <Border x:Name="RamBarHost" Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0"><ProgressBar x:Name="RamBar" Maximum="100"/></Border>
                                        <TextBlock x:Name="RamPercentValue" Grid.Column="2" HorizontalAlignment="Right" FontSize="14" Style="{StaticResource MonoValue}"/>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="StoragePanel"/>
                                <StackPanel x:Name="FanSection">
                                    <Border x:Name="FanRow" Tag="Row" Style="{StaticResource Row}"><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="FanLabelColumn" Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource IconFan}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/><TextBlock Text="{DynamicResource Common.Fans}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/></StackPanel><StackPanel x:Name="FanPanel" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Common.Searching}" Style="{StaticResource MetaText}"/></StackPanel></Grid></Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="CompactView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="32,28">
                <StackPanel HorizontalAlignment="Stretch" MaxWidth="900">
                    <TextBlock x:Name="CompactStatusText" Text="{DynamicResource Status.ReadingSensors}" Style="{StaticResource MetaText}" Margin="2,0,0,14"/>
                    <UniformGrid x:Name="CompactCardsGrid" Columns="2" Margin="-8,0">
                        <Border Style="{StaticResource Card}" Margin="8,0" Cursor="Hand" MouseLeftButtonUp="CpuCard_Click">
                            <StackPanel>
                                <Grid x:Name="CompactCpuStateHeader" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource IconCpu}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Head.Processor}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel x:Name="CompactCpuStateBadge" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{Binding Foreground,ElementName=CompactCpuTemp}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="CompactCpuState" Text="{DynamicResource Common.Normal}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </Grid>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="CompactCpuTemp" Text="—" FontSize="44" LineHeight="48" FontWeight="SemiBold" Style="{StaticResource MonoValue}" Foreground="{DynamicResource TempNormalBrush}"/>
                                        <TextBlock x:Name="CompactCpuUnit" Text="°C" FontSize="18" FontWeight="Medium" Foreground="{Binding Foreground,ElementName=CompactCpuTemp}" Margin="4,0,0,7" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7"><TextBlock x:Name="CompactCpuSecondaryLabel" Text="{DynamicResource Common.Load}" Style="{StaticResource FieldLabel}" TextAlignment="Right"/><TextBlock x:Name="CompactCpuStats" Text="—" FontSize="15" Style="{StaticResource MonoValue}" TextAlignment="Right"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0" Cursor="Hand" MouseLeftButtonUp="GpuCard_Click">
                            <StackPanel>
                                <Grid x:Name="CompactGpuStateHeader" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource IconGpu}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" VerticalAlignment="Center"/><TextBlock x:Name="CompactGpuTitle" Text="{DynamicResource Head.GraphicsCard}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel x:Name="CompactGpuStateBadge" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{Binding Foreground,ElementName=CompactGpuTemp}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="CompactGpuState" Text="{DynamicResource Common.Normal}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </Grid>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="CompactGpuTemp" Text="—" FontSize="44" LineHeight="48" FontWeight="SemiBold" Style="{StaticResource MonoValue}" Foreground="{DynamicResource TempNormalBrush}"/>
                                        <TextBlock x:Name="CompactGpuUnit" Text="°C" FontSize="18" FontWeight="Medium" Foreground="{Binding Foreground,ElementName=CompactGpuTemp}" Margin="4,0,0,7" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7"><TextBlock x:Name="CompactGpuSecondaryLabel" Text="{DynamicResource Common.Load}" Style="{StaticResource FieldLabel}" TextAlignment="Right"/><TextBlock x:Name="CompactGpuStats" Text="—" FontSize="15" Style="{StaticResource MonoValue}" TextAlignment="Right"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource ListCard}" Margin="0,14,0,0">
                        <StackPanel x:Name="CompactSystemList">
                            <Border x:Name="CompactRamRow" Tag="Row" Style="{StaticResource Row}" Cursor="Hand" MouseLeftButtonUp="RamCard_Click">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="CompactRamLabelColumn" Width="260"/><ColumnDefinition/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource IconMemory}" Width="15" Height="15" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/><TextBlock Text="{DynamicResource Common.Ram}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0"/><TextBlock x:Name="CompactRamValue" Text="—" Style="{StaticResource MetaText}" Margin="7,1,0,0" VerticalAlignment="Center"/></StackPanel>
                                    <Border Grid.Column="1" Width="220" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0"><ProgressBar x:Name="CompactRamBar" Maximum="100"/></Border>
                                    <TextBlock x:Name="CompactRam" Grid.Column="2" Text="—" HorizontalAlignment="Right" FontSize="14" Style="{StaticResource MonoValue}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MiniView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="32,28">
                <StackPanel HorizontalAlignment="Stretch" MaxWidth="1080">
                    <Grid x:Name="MiniHeader" Margin="2,0,2,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="MiniStatusText" Text="{DynamicResource Status.ReadingSensors}" Style="{StaticResource MetaText}"/>
                            <TextBlock x:Name="MiniSessionSince" Style="{StaticResource MetaText}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="MiniActions" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Session.Reset}" Style="{StaticResource PillButton}" Height="30" Click="ResetSession_Click"/>
                        </StackPanel>
                    </Grid>
                    <UniformGrid x:Name="MiniCardsGrid" Columns="3" Margin="-8,0">
                        <Border x:Name="MiniCpuCard" Style="{StaticResource Card}" Margin="8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource IconCpu}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/><TextBlock Text="{DynamicResource Head.Processor}" Style="{StaticResource ComponentTitle}" Margin="9,0,0,0"/></StackPanel>
                                <TextBlock x:Name="MiniCpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Style="{StaticResource MonoValue}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="MiniCpuSecondary" Style="{StaticResource MetaText}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="MiniCpuRange" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="MiniGpuCard" Style="{StaticResource Card}" Margin="8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource IconGpu}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/><TextBlock Text="{DynamicResource Head.GraphicsCard}" Style="{StaticResource ComponentTitle}" Margin="9,0,0,0"/></StackPanel>
                                <TextBlock x:Name="MiniGpuValue" Text="—" FontSize="34" FontWeight="SemiBold" Style="{StaticResource MonoValue}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="MiniGpuSecondary" Style="{StaticResource MetaText}" Margin="0,3,0,0"/>
                                <TextBlock x:Name="MiniGpuRange" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="MiniRamCard" Style="{StaticResource Card}" Margin="8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource IconMemory}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8"/><TextBlock Text="{DynamicResource Common.Memory}" Style="{StaticResource ComponentTitle}" Margin="9,0,0,0"/></StackPanel>
                                <TextBlock x:Name="MiniRamValue" Text="—" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Style="{StaticResource MonoValue}" Margin="0,10,0,0"/>
                                <TextBlock x:Name="MiniRamSecondary" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                <TextBlock x:Name="MiniRamRange" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="{DynamicResource Session.MemoryOnly}" Style="{StaticResource MetaText}" TextWrapping="Wrap" Margin="2,14,2,0"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DetailedView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="32,28"><StackPanel HorizontalAlignment="Stretch" MaxWidth="1680">
                <TextBlock x:Name="DetailedStatusText" Text="{DynamicResource Status.FirstRead}" Style="{StaticResource MetaText}" Margin="2,0,0,14"/>
                <UniformGrid x:Name="DetailedChartGrid" Columns="2" Margin="-8,0">
                    <Border Style="{StaticResource Card}" Margin="8,0" Cursor="Hand" MouseLeftButtonUp="CpuCard_Click">
                        <StackPanel>
                            <Grid x:Name="DetailedCpuStateHeader" Margin="0,0,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource IconCpu}" Width="14" Height="14" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Head.Processor}" Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                <StackPanel x:Name="DetailedCpuStateBadge" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{Binding Foreground,ElementName=DetailedCpuValue}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="DetailedCpuState" Text="{DynamicResource Common.Normal}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                            <TextBlock x:Name="DetailedCpuName" Text="{DynamicResource Common.Detecting}" Style="{StaticResource ComponentTitle}"/>
                            <Grid Margin="0,6,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="DetailedCpuValue" Text="—" FontSize="44" LineHeight="48" FontWeight="SemiBold" Style="{StaticResource MonoValue}" Foreground="{DynamicResource TempNormalBrush}"/>
