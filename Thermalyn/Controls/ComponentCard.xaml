<UserControl x:Class="Thermalyn.Controls.ComponentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Thermalyn.Controls">
    <Border Style="{StaticResource Card}" Cursor="Hand">
        <StackPanel>
            <Grid x:Name="HeaderGrid" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <controls:Icon Data="{Binding IconData, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Width="14" Height="14" Stroke="{DynamicResource IconBrush}"
                                   StrokeThickness="1.8" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource SectionTitle}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="HeaderState" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{Binding Foreground,ElementName=PrimaryValue}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Text="{DynamicResource Common.Normal}" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="ComponentName" Text="{DynamicResource Common.Detecting}" Style="{StaticResource ComponentTitle}"/>
            <Grid x:Name="ValueGrid" Margin="0,6,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock x:Name="PrimaryValue" Text="—" FontSize="56" LineHeight="62" FontWeight="SemiBold" Style="{StaticResource MonoValue}" Foreground="{DynamicResource TempNormalBrush}"/>
                    <TextBlock x:Name="PrimaryUnit" Text="°C" FontSize="22" FontWeight="Medium" Foreground="{Binding Foreground,ElementName=PrimaryValue}" Margin="5,0,0,9" VerticalAlignment="Bottom"/>
                </StackPanel>
                <Grid x:Name="SecondaryMetricsGrid" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,26,0"><TextBlock x:Name="SecondaryLabel" Text="{DynamicResource Common.Load}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SecondaryValue" Text="—" FontSize="15" Style="{StaticResource MonoValue}"/></StackPanel>
                    <StackPanel x:Name="FanMetric" Grid.Column="1"><TextBlock Text="{DynamicResource Common.Fan}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="FanValue" Text="—" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                </Grid>
            </Grid>
            <controls:RingGauge x:Name="Gauge" Visibility="Collapsed"/>
            <Grid>
                <controls:HistoryChart x:Name="Chart" Height="150" Stroke="{DynamicResource AccentBrush}"/>
                <UniformGrid x:Name="NoGraphSummary" Columns="2" Visibility="Collapsed" Margin="0,6">
                    <StackPanel><TextBlock Text="{DynamicResource Common.Temperature}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="NoGraphTemperature" FontSize="22" Style="{StaticResource MonoValue}" Foreground="{Binding Foreground,ElementName=PrimaryValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="{DynamicResource Common.Load}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding Text,ElementName=SecondaryValue}" FontSize="22" Style="{StaticResource MonoValue}"/></StackPanel>
                    <StackPanel><TextBlock x:Name="ThirdLabel" Text="{DynamicResource Common.Frequency}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="ThirdValue" FontSize="18" Style="{StaticResource MonoValue}"/></StackPanel>
                    <StackPanel><TextBlock x:Name="FourthLabel" Text="{DynamicResource Common.Power}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="FourthValue" FontSize="18" Style="{StaticResource MonoValue}"/></StackPanel>
                </UniformGrid>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
